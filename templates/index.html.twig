{% extends "main.html.twig" %}

{% block main %}
<div class="col-md-12">

    <div class="mb-4 mt-2">
        <div class="section-label">Add geocaches</div>
        <div class="section-title">Search by geocode <small style="font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); font-weight: 400;">published, locked, archived…</small></div>

        {% if app.user.membershipLevelId == 1 %}
        <div class="alert alert-info mb-3" role="alert">
            As a basic Geocaching member, you can download full details of <strong>3 geocaches per 24 hours</strong>.
            Upgrade to Premium for full access.
        </div>
        {% endif %}

        <textarea id="geocodes" class="form-control mb-2" placeholder="Type geocodes here..."></textarea>
        <button type="submit" class="btn btn-primary" id="search-geocodes">
            <i class="bi bi-plus-lg"></i> Add to list
        </button>
    </div>

    <hr>

    <div id="unpublishedCachesBlock">
        <div class="section-label">Your geocaches</div>
        <div class="section-title">Geocache list <span id="totalGeocaches"></span></div>

        <div id="block_select">
            <span>
                <input type="checkbox" id="chk_select"> <label for="chk_select">Pick 100 geocaches</label>
            </span>
            <input type="range" value="100" min="5" max="500" step="5" name="">
        </div>

        <div id="fetching-unpublished-caches">
            <img src="{{ asset('loader.gif') }}" alt="" width="16"> Fetching your unpublished caches…
        </div>

        <div id="no-geocaches-message" class="alert alert-info" role="alert" style="display: none;">
            No geocaches found.
        </div>

        <div id="table-unpublished-caches">
            <table id="table-caches" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th scope="col" class="head-pick"><input type="checkbox" id="select-all" title="Select all"></th>
                        <th scope="col" style="width: 30px;"></th>
                        <th scope="col" style="width: 120px;">Geocode</th>
                        <th scope="col">Title</th>
                        <th scope="col" class="head-link" style="width: 30px;"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

            <fieldset>
                <legend>Create GPX file</legend>

                <div id="block_split">
                    <span>
                        <input type="checkbox" id="chk_split"> <label for="chk_split">Split GPX files by 100 geocaches</label>
                    </span>
                    <input type="range" value="100" min="5" max="500" step="5" name="">
                </div>

                <button type="submit" class="btn btn-primary" id="create-gpx">
                    <i class="bi bi-file-earmark-arrow-down"></i> Create GPX
                </button>

                <ul id="download-links"></ul>
            </fieldset>
        </div>
    </div>

</div>
{% endblock %}
