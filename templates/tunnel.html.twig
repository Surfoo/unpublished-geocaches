{% extends "main.html.twig" %}

{% block main %}
<div class="col-12">
    <div class="hero-section">

        <svg class="hero-decoration" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <ellipse cx="200" cy="220" rx="22"  ry="12"  stroke="currentColor" stroke-width="1.5"/>
            <ellipse cx="200" cy="220" rx="46"  ry="26"  stroke="currentColor" stroke-width="1"/>
            <ellipse cx="200" cy="220" rx="74"  ry="44"  stroke="currentColor" stroke-width="1.5"/>
            <ellipse cx="200" cy="220" rx="104" ry="64"  stroke="currentColor" stroke-width="1"/>
            <ellipse cx="200" cy="220" rx="136" ry="86"  stroke="currentColor" stroke-width="1.5"/>
            <ellipse cx="200" cy="220" rx="170" ry="108" stroke="currentColor" stroke-width="1"/>
            <ellipse cx="200" cy="220" rx="206" ry="132" stroke="currentColor" stroke-width="1"/>
            <ellipse cx="200" cy="220" rx="244" ry="158" stroke="currentColor" stroke-width="1.5"/>
            <ellipse cx="200" cy="220" rx="284" ry="186" stroke="currentColor" stroke-width="1"/>
            <line x1="196" y1="216" x2="204" y2="224" stroke="currentColor" stroke-width="2"/>
            <line x1="204" y1="216" x2="196" y2="224" stroke="currentColor" stroke-width="2"/>
        </svg>

        <div>
            <span class="hero-eyebrow">◎ GPX export tool</span>
